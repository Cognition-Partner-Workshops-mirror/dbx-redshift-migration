table finance_export
	column fiscal_year
		dataType: int64
		sourceColumn: fiscal_year

	column fiscal_qtr
		dataType: string
		sourceColumn: fiscal_qtr

	column order_count
		dataType: int64
		sourceColumn: order_count

	column revenue
		dataType: double
		sourceColumn: revenue

	partition finance_export = m
		mode: import
		source =
			let
				Source = Warehouse,
				Rows = Value.NativeQuery(Source, "-- BI report: fiscal-year revenue summary.#(lf)SELECT fiscal_year, fiscal_qtr,#(lf)       SUM(order_count) AS order_count,#(lf)       SUM(revenue)     AS revenue#(lf)FROM   mart.finance_monthly#(lf)GROUP  BY fiscal_year, fiscal_qtr#(lf)ORDER  BY fiscal_year, fiscal_qtr;#(lf)", null, [EnableFolding=true])
			in
				Rows
