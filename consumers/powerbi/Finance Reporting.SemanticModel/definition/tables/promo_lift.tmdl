table promo_lift
	column sales_channel
		dataType: string
		sourceColumn: sales_channel

	column order_count
		dataType: int64
		sourceColumn: order_count

	column median_order_value
		dataType: double
		sourceColumn: median_order_value

	column p90_order_value
		dataType: double
		sourceColumn: p90_order_value

	partition promo_lift = m
		mode: import
		source =
			let
				Source = Warehouse,
				Rows = Value.NativeQuery(Source, "-- BI report: channel order-value distribution as published.#(lf)SELECT sales_channel, order_count, median_order_value, p90_order_value#(lf)FROM   mart.promo_lift#(lf)ORDER  BY sales_channel;#(lf)", null, [EnableFolding=true])
			in
				Rows
