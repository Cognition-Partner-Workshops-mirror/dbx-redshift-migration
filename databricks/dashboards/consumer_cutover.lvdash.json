{
  "datasets": [
    {
      "name": "naive",
      "displayName": "Latest naive run",
      "queryLines": [
        "WITH runs AS (\n",
        "  SELECT mode, run_id, MAX(run_at) AS run_at FROM results GROUP BY mode, run_id\n",
        "), ranked AS (\n",
        "  SELECT *, ROW_NUMBER() OVER (PARTITION BY mode ORDER BY run_at DESC, run_id DESC) AS rn FROM runs\n",
        "), latest AS (\n",
        "  SELECT r.* FROM results r JOIN ranked x ON r.mode = x.mode AND r.run_id = x.run_id WHERE x.rn = 1\n",
        ")\n",
        "SELECT COUNT_IF(status = 'PASS') AS passed, COUNT_IF(status = 'SMOKE') AS smoke, COUNT(*) AS total FROM latest WHERE mode = 'naive'"
      ]
    },
    {
      "name": "current",
      "displayName": "Latest current run",
      "queryLines": [
        "WITH runs AS (\n",
        "  SELECT mode, run_id, MAX(run_at) AS run_at FROM results GROUP BY mode, run_id\n",
        "), ranked AS (\n",
        "  SELECT *, ROW_NUMBER() OVER (PARTITION BY mode ORDER BY run_at DESC, run_id DESC) AS rn FROM runs\n",
        "), latest AS (\n",
        "  SELECT r.* FROM results r JOIN ranked x ON r.mode = x.mode AND r.run_id = x.run_id WHERE x.rn = 1\n",
        ")\n",
        "SELECT COUNT_IF(status = 'PASS') AS passed, COUNT_IF(status = 'SMOKE') AS smoke, COUNT(*) AS total FROM latest WHERE mode = 'current'"
      ]
    },
    {
      "name": "details",
      "displayName": "Latest results by mode",
      "queryLines": [
        "WITH runs AS (\n",
        "  SELECT mode, run_id, MAX(run_at) AS run_at FROM results GROUP BY mode, run_id\n",
        "), ranked AS (\n",
        "  SELECT *, ROW_NUMBER() OVER (PARTITION BY mode ORDER BY run_at DESC, run_id DESC) AS rn FROM runs\n",
        "), latest AS (\n",
        "  SELECT r.* FROM results r JOIN ranked x ON r.mode = x.mode AND r.run_id = x.run_id WHERE x.rn = 1\n",
        ")\n",
        "SELECT mode, consumer, query_id, status, rows_expected, rows_actual, mismatched_rows, detail, run_at\n",
        "FROM latest ORDER BY mode, consumer, query_id"
      ]
    }
  ],
