{
  "datasets": [
    {
      "name": "revenue",
      "displayName": "Certified order metrics",
      "asset_name": "demo_redshift.customer_360.revenue_metrics"
    },
    {
      "name": "health",
      "displayName": "Certified customer health",
      "asset_name": "demo_redshift.customer_360.customer_health_metrics"
    },
    {
      "name": "legacy",
      "displayName": "Legacy comparison",
      "queryLines": [
        "SELECT kpi, IF(unit = '%', CONCAT(FORMAT_NUMBER(legacy_value, 2), '%'), CONCAT('$', FORMAT_NUMBER(legacy_value, 2))) AS legacy,\n",
        "       IF(unit = '%', CONCAT(FORMAT_NUMBER(certified_value, 2), '%'), CONCAT('$', FORMAT_NUMBER(certified_value, 2))) AS certified,\n",
        "       explanation\n",
        "FROM legacy_vs_certified ORDER BY display_order"
      ]
    }
  ],
