        }
      ]
    },
    {
      "name": "legacy_comparison",
      "displayName": "Legacy Comparison",
      "queryLines": [
        "SELECT kpi, legacy_value, certified_value, difference, explanation FROM demo_redshift.customer_360.legacy_vs_certified ORDER BY kpi\n"
      ]
    },
    {
      "name": "normalized_comparison",
      "displayName": "Normalized Comparison",
      "queryLines": [
        "WITH base AS (SELECT kpi, legacy_value, certified_value FROM demo_redshift.customer_360.legacy_vs_certified WHERE kpi IN ('total_revenue', 'aov', 'avg_customer_ltv')) SELECT kpi, 'Legacy' AS series, 1.0 AS relative_value FROM base UNION ALL SELECT kpi, 'Certified' AS series, TRY_DIVIDE(certified_value, legacy_value) AS relative_value FROM base ORDER BY kpi, series\n"
      ]
    },
    {
      "name": "options_fiscal_quarter",
      "displayName": "Options Fiscal Quarter",
      "queryLines": [
        "SELECT 'All' AS fiscal_quarter UNION ALL SELECT DISTINCT fiscal_quarter FROM demo_redshift.customer_360.revenue_metrics GROUP BY ALL ORDER BY fiscal_quarter\n"
      ]
    },
    {
      "name": "options_sales_channel",
      "displayName": "Options Sales Channel",
      "queryLines": [
        "SELECT 'All' AS sales_channel UNION ALL SELECT DISTINCT sales_channel FROM demo_redshift.customer_360.revenue_metrics GROUP BY ALL ORDER BY sales_channel\n"
      ]
    },
    {
      "name": "options_region",
      "displayName": "Options Region",
      "queryLines": [
        "SELECT 'All' AS region UNION ALL SELECT DISTINCT region FROM demo_redshift.customer_360.revenue_metrics GROUP BY ALL ORDER BY region\n"
      ]
    }
  ],
