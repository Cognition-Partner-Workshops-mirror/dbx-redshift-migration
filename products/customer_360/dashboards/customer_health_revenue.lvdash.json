    {
      "name": "health_summary",
      "displayName": "Health Summary",
      "queryLines": [
        "SELECT MEASURE(active_customers) AS active_customers, MEASURE(revenue_at_risk) AS revenue_at_risk FROM demo_redshift.customer_360.customer_health_metrics WHERE (:region = 'All' OR region = :region) \n"
      ],
      "parameters": [
        {
          "keyword": "region",
