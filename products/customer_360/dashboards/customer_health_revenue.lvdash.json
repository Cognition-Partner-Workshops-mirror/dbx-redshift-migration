            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "fiscal_quarter",
                    "displayName": "Fiscal quarter",
                    "queryName": "ds_revenue_fiscal_quarter"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Fiscal quarter"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 4,
            "height": 2
          }
        },
