    {
      "name": "health_mix",
      "displayName": "Health Mix",
      "queryLines": [
        "SELECT health_segment, MEASURE(customers) AS customers FROM demo_redshift.customer_360.customer_health_metrics WHERE (:region = 'All' OR region = :region) GROUP BY ALL ORDER BY customers DESC\n"
      ],
      "parameters": [
        {
