{
  "datasets": [
    {
      "name": "ds_revenue",
      "displayName": "revenue_metrics",
      "asset_name": "demo_redshift.customer_360.revenue_metrics"
    },
    {
      "name": "ds_health",
      "displayName": "customer_health_metrics",
      "asset_name": "demo_redshift.customer_360.customer_health_metrics"
    },
    {
      "name": "ds_legacy",
      "displayName": "legacy_vs_certified",
      "queryLines": [
        "SELECT sort_order, kpi, unit, legacy_value, certified_value, explanation\n",
        "FROM demo_redshift.customer_360.legacy_vs_certified\n",
        "ORDER BY sort_order"
      ]
    },
    {
      "name": "ds_legacy_usd",
      "displayName": "legacy_vs_certified (revenue)",
      "queryLines": [
        "SELECT sort_order, kpi, legacy_value, certified_value\n",
        "FROM demo_redshift.customer_360.legacy_vs_certified\n",
        "WHERE kpi IN ('Total revenue', 'Fiscal Q1 revenue')\n",
        "ORDER BY sort_order"
      ]
    }
  ],
  "pages": [
    {
      "name": "executive",
      "displayName": "Executive overview",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "header",
            "multilineTextboxSpec": {
              "lines": [
                "# Customer Health & Revenue\n",
                "\n",
                "Certified KPIs from the `customer_360` metric views, **as of 2025-12-31**. Net revenue counts completed orders only; ",
                "gross is what legacy Redshift reported. Fiscal year starts Feb 1 (Q1 = Feb-Apr). See **Legacy vs certified** for why the numbers moved."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 3
          }
        },
