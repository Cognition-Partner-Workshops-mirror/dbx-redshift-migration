      "name": "regional_risk",
      "displayName": "Regional Risk",
      "queryLines": [
        "SELECT region, MEASURE(revenue_at_risk) AS revenue_at_risk FROM demo_redshift.customer_360.customer_health_metrics WHERE (:region = 'All' OR region = :region) GROUP BY ALL ORDER BY revenue_at_risk DESC\n"
