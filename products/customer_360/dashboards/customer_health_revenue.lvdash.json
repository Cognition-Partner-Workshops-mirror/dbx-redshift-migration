    {
      "name": "legacy_vs_certified",
      "displayName": "Legacy vs certified",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "legacy_header",
            "multilineTextboxSpec": {
              "lines": [
                "# Legacy vs certified\n",
                "\n",
                "The migrated Redshift estate reproduces legacy logic faithfully, bugs included. Each row shows the legacy number, the certified `customer_360` number and why they differ."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "legacy_table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_legacy",
                  "fields": [
                    {
                      "name": "sort_order",
                      "expression": "`sort_order`"
                    },
                    {
                      "name": "kpi",
                      "expression": "`kpi`"
                    },
                    {
                      "name": "unit",
                      "expression": "`unit`"
                    },
                    {
                      "name": "legacy_value",
                      "expression": "`legacy_value`"
                    },
                    {
                      "name": "certified_value",
                      "expression": "`certified_value`"
                    },
                    {
                      "name": "explanation",
                      "expression": "`explanation`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "kpi",
                    "displayName": "KPI"
                  },
                  {
                    "fieldName": "unit",
                    "displayName": "Unit"
                  },
                  {
                    "fieldName": "legacy_value",
                    "displayName": "Legacy",
                    "format": {
                      "type": "number-plain",
                      "abbreviation": "none",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 4
                      }
                    }
                  },
                  {
                    "fieldName": "certified_value",
                    "displayName": "Certified",
                    "format": {
                      "type": "number-plain",
                      "abbreviation": "none",
                      "decimalPlaces": {
                        "type": "max",
                        "places": 4
                      }
                    }
                  },
                  {
                    "fieldName": "explanation",
                    "displayName": "Why it differs"
                  }
                ]
              },
              "frame": {
                "title": "Legacy vs certified KPIs",
                "showTitle": true
              }
            }
