{
  "datasets": [
    {
      "name": "revenue_summary",
      "displayName": "Revenue Summary",
      "queryLines": [
        "SELECT MEASURE(net_revenue) AS net_revenue, MEASURE(revenue_leakage) AS revenue_leakage, MEASURE(aov) AS aov, MEASURE(on_time_delivery_pct) / 100.0 AS on_time_delivery FROM demo_redshift.customer_360.revenue_metrics WHERE (:fiscal_quarter = 'All' OR fiscal_quarter = :fiscal_quarter) AND (:sales_channel = 'All' OR sales_channel = :sales_channel) AND (:region = 'All' OR region = :region) \n"
      ],
      "parameters": [
        {
          "keyword": "fiscal_quarter",
          "displayName": "Fiscal Quarter",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        },
        {
          "keyword": "sales_channel",
          "displayName": "Sales Channel",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        },
        {
          "keyword": "region",
          "displayName": "Region",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "monthly_revenue",
      "displayName": "Monthly Revenue",
      "queryLines": [
        "SELECT order_month, MEASURE(gross_revenue) AS gross_revenue, MEASURE(net_revenue) AS net_revenue FROM demo_redshift.customer_360.revenue_metrics WHERE (:fiscal_quarter = 'All' OR fiscal_quarter = :fiscal_quarter) AND (:sales_channel = 'All' OR sales_channel = :sales_channel) AND (:region = 'All' OR region = :region) GROUP BY ALL ORDER BY order_month\n"
      ],
      "parameters": [
        {
          "keyword": "fiscal_quarter",
          "displayName": "Fiscal Quarter",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        },
        {
          "keyword": "sales_channel",
          "displayName": "Sales Channel",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        },
        {
          "keyword": "region",
          "displayName": "Region",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "channel_revenue",
      "displayName": "Channel Revenue",
      "queryLines": [
        "SELECT sales_channel, MEASURE(net_revenue) AS net_revenue FROM demo_redshift.customer_360.revenue_metrics WHERE (:fiscal_quarter = 'All' OR fiscal_quarter = :fiscal_quarter) AND (:sales_channel = 'All' OR sales_channel = :sales_channel) AND (:region = 'All' OR region = :region) GROUP BY ALL ORDER BY net_revenue DESC\n"
